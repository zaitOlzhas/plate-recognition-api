{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "LprWebhook.RawBody": "Debug"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=events.db"
  },
  "Swagger": {
    "Enabled": true
  },
  "PlateEvents": {
    "DuplicateWindowSeconds": 30
  },
  "TelegramBot": {
    "Enabled": false,
    "BotToken": "",
    "OwnerUserId": null,
    "WebBaseUrl": "",
    "Relay": {
      "BaseUrl": "http://192.168.1.10",
      "Endpoint": "out1_pulse"
    }
  },
  "AllowedHosts": "*"
}
